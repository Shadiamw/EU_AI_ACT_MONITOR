{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pod-h-report-1.schema.json",
  "title": "Pod H report, schema_version pod-h-report-1 (Phase 5 spec 3.3.1; contract change C3, proposed)",
  "description": "The Report object of GET /v1/events/{event_id}/report. Proposed: the contract names a Report object and defines no fields. AC-13 requires the event data, all four Art. 3(49) fields, the reviewer's determination, and the detection, determination and report-assembly timestamps, all non-null. JSON Schema cannot compare fields, so the ordering detected_at < determined_at < assembled_at is a separate test assertion.",
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tier": {
      "enum": ["DEATH", "CRITICAL_INFRASTRUCTURE_OR_WIDESPREAD", "OTHER_SERIOUS", "NOT_SERIOUS"]
    },
    "harmField": {
      "type": "object",
      "required": ["status", "evidence", "confirmed_by", "confirmed_at"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["CONFIRMED", "NOT_APPLICABLE"] },
        "evidence": { "type": ["string", "null"] },
        "confirmed_by": { "type": "string", "minLength": 1 },
        "confirmed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["seq", "hash"],
      "additionalProperties": false,
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "templateField": {
      "type": "object",
      "required": ["field", "name", "status", "value"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "section",
            "group",
            "mapped",
            "derivable",
            "requires_reviewer_input",
            "not_available"
          ]
        },
        "value": {},
        "note": { "type": "string" }
      }
    }
  },
  "type": "object",
  "required": [
    "report_id",
    "report_version",
    "report_kind",
    "schema_version",
    "event",
    "harm_fields",
    "determination",
    "timestamps",
    "risk_indicator",
    "regulation",
    "submission_marking",
    "article73_template",
    "ledger_anchor"
  ],
  "additionalProperties": false,
  "properties": {
    "report_id": { "type": "string", "pattern": "^rpt-[0-9a-f]{32}$" },
    "report_version": { "type": "integer", "minimum": 1 },
    "report_kind": { "enum": ["SERIOUS_INCIDENT", "NOT_SERIOUS_CLOSURE"] },
    "schema_version": { "const": "pod-h-report-1" },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "system_id",
        "type",
        "metric_name",
        "observed_value",
        "threshold_value",
        "detected_at",
        "evidence_bundle",
        "evidence_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "system_id": { "type": "string", "minLength": 1 },
        "type": { "const": "threshold_breach" },
        "metric_name": { "type": "string", "minLength": 1 },
        "observed_value": { "type": "number" },
        "threshold_value": { "type": "number" },
        "detected_at": { "$ref": "#/$defs/timestamp" },
        "evidence_bundle": {
          "type": "object",
          "required": ["window", "samples"],
          "properties": {
            "window": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "$ref": "#/$defs/timestamp" },
                "end": { "$ref": "#/$defs/timestamp" }
              }
            },
            "samples": { "type": "array", "minItems": 1 }
          }
        },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "harm_fields": {
      "type": "object",
      "required": [
        "health_safety_harm",
        "critical_infrastructure_disruption",
        "fundamental_rights_infringement",
        "property_environmental_damage"
      ],
      "additionalProperties": false,
      "properties": {
        "health_safety_harm": { "$ref": "#/$defs/harmField" },
        "critical_infrastructure_disruption": { "$ref": "#/$defs/harmField" },
        "fundamental_rights_infringement": { "$ref": "#/$defs/harmField" },
        "property_environmental_damage": { "$ref": "#/$defs/harmField" }
      }
    },
    "determination": {
      "type": "object",
      "required": [
        "tier",
        "tier_label",
        "rationale",
        "disposition_id",
        "reviewer_id",
        "assigned_at",
        "deadline_utc",
        "calendar",
        "revisions"
      ],
      "additionalProperties": false,
      "properties": {
        "tier": { "$ref": "#/$defs/tier" },
        "tier_label": { "type": "string", "minLength": 1 },
        "rationale": { "type": ["string", "null"] },
        "disposition_id": { "type": "string", "pattern": "^dsp-" },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "assigned_at": { "$ref": "#/$defs/timestamp" },
        "deadline_utc": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "calendar": { "type": "string", "minLength": 1 },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["prior_tier", "new_tier", "reviewer_id", "revised_at"],
            "additionalProperties": false,
            "properties": {
              "prior_tier": { "$ref": "#/$defs/tier" },
              "new_tier": { "$ref": "#/$defs/tier" },
              "reviewer_id": { "type": "string", "minLength": 1 },
              "revised_at": { "$ref": "#/$defs/timestamp" }
            }
          }
        }
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["detected_at", "determined_at", "last_revised_at", "assembled_at"],
      "additionalProperties": false,
      "properties": {
        "detected_at": { "$ref": "#/$defs/timestamp" },
        "determined_at": { "$ref": "#/$defs/timestamp" },
        "last_revised_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "assembled_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "risk_indicator": {
      "type": "object",
      "required": ["detection_to_assignment_seconds"],
      "additionalProperties": false,
      "properties": {
        "detection_to_assignment_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "regulation": {
      "type": "object",
      "required": [
        "instrument",
        "reporting_article",
        "serious_incident_definition",
        "reporting_window_days"
      ],
      "additionalProperties": false,
      "properties": {
        "instrument": { "const": "Regulation (EU) 2024/1689" },
        "reporting_article": { "const": "Article 73" },
        "serious_incident_definition": { "const": "Article 3(49)" },
        "reporting_window_days": { "enum": [2, 10, 15, null] }
      }
    },
    "submission_marking": { "enum": [null, "NOT FOR SUBMISSION"] },
    "article73_template": {
      "type": "object",
      "required": ["template", "template_version", "template_reference", "fields"],
      "additionalProperties": false,
      "properties": {
        "template": {
          "const": "Incident Report for Serious Incidents under the AI Act (High-risk AI systems)"
        },
        "template_version": { "const": "1.0.0" },
        "template_reference": { "const": "SB-10407" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/templateField" }
        }
      }
    },
    "ledger_anchor": { "$ref": "#/$defs/anchor" }
  },
  "allOf": [
    {
      "if": { "properties": { "report_kind": { "const": "SERIOUS_INCIDENT" } } },
      "then": {
        "properties": {
          "submission_marking": { "const": null },
          "determination": {
            "properties": {
              "tier": { "enum": ["DEATH", "CRITICAL_INFRASTRUCTURE_OR_WIDESPREAD", "OTHER_SERIOUS"] },
              "deadline_utc": { "$ref": "#/$defs/timestamp" }
            }
          },
          "regulation": { "properties": { "reporting_window_days": { "enum": [2, 10, 15] } } }
        }
      },
      "else": {
        "properties": {
          "submission_marking": { "const": "NOT FOR SUBMISSION" },
          "determination": {
            "properties": {
              "tier": { "const": "NOT_SERIOUS" },
              "rationale": { "type": "string", "minLength": 1 },
              "deadline_utc": { "type": "null" }
            }
          },
          "regulation": { "properties": { "reporting_window_days": { "type": "null" } } }
        }
      }
    }
  ]
}
