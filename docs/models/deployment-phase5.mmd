---
title: "Deployment view (Phase 5): Fly.io and Vercel, the Docker Compose stack used in CI, and the chain-head workflow"
---
flowchart LR
    IMG["One Docker image (Dockerfile):<br/>python:3.12-slim-bookworm, app, migrations, tools, tests, scripts;<br/>build argument GIT_SHA becomes APP_VERSION (/healthz version)"]
    VER["Vercel static site<br/>app/static copied to web/ by scripts/vercel-build.mjs,<br/>config.js carries API_BASE_URL"]
    subgraph FLY["Fly.io app eu-ai-act-monitor-api (fly.toml on main, region iad)"]
        API["process api<br/>python -m app.runtime api (uvicorn, port 8000);<br/>also serves /ui/; Fly health check GET /livez"]
        WRK["process worker<br/>python -m app.runtime worker<br/>gap sweep, fire_due reminders, deliver_due,<br/>nightly verification (from NIGHTLY_VERIFY_HOUR_UTC), alert step"]
        REL["release_command prepare<br/>(alembic upgrade, seed)"]
    end
    subgraph CMP["docker-compose.yml (local runs and CI image job)"]
        CPG[("postgres<br/>postgres:16")]
        CMI["migrate<br/>prepare"]
        CAPI["api<br/>port 8000"]
        CWK["worker"]
        CSK["sink<br/>tools/webhook_sink.py, port 8765"]
    end
    subgraph GHCI["GitHub Actions, CI"]
        CIJ["ci.yml, job image<br/>docker compose up -d --build --wait;<br/>HTTP acceptance runner, Model 5 examples,<br/>Phase 4 demo, Phase 5 demo (AC-16 trace)"]
    end
    subgraph GHCH["GitHub Actions, chain head"]
        CHW["chain-head.yml (cron 17 3 * * *, or by hand)<br/>tools/verify_ledger.py --anchor from main;<br/>scheduled only once on main"]
        CHB[("branch chain-heads<br/>heads.jsonl; created at deploy time, not yet present")]
    end
    CL["API clients<br/>(monitored system, partner team)"]
    RCV["Registered webhook receivers"]
    PG[("Fly Postgres<br/>separate Fly app, attached by secrets")]
    BR["Browser (reviewer or viewer)"]

    BR -- "HTTPS: loads console" --> VER
    BR -- "HTTPS JSON + Bearer key" --> API
    REL -- "SQL migrations" --> PG
    CL -- "HTTPS JSON + Bearer key" --> API
    API -- "HTTPS POST (clock advance runs the worker steps)" --> RCV
    CAPI -- "HTTP webhooks" --> CSK
    CMI -- "SQL" --> CPG
    CAPI -- "SQL" --> CPG
    CWK -- "HTTP webhooks" --> CSK
    WRK -- "HTTPS POST webhooks" --> RCV
    CWK -- "SQL" --> CPG
    WRK -- "SQL" --> PG
    API -- "SQL" --> PG
    CIJ -- "starts the stack; HTTP to api :8000, reads sink :8765" --> CMP
    API -- "export and /healthz, pulled by the workflow:<br/>GET /v1/ledger/export (POD_VIEWER_KEY) and /healthz at vars.POD_BASE_URL" --> CHW
    CHW -- "appends heads.jsonl, push without force" --> CHB
    IMG -. "runs as api, worker and release_command" .-> FLY
    IMG -. "runs as migrate, api, worker and sink" .-> CMP
